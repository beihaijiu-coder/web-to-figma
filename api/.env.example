# Copy this file to .env.local. Never commit .env.local.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787

# Clerk development instance
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Comma-separated website origins allowed to call this API.
CLERK_AUTHORIZED_PARTIES=http://localhost:4173
# Figma plugin UI may use the opaque "null" origin or figma.com in development.
# The Chrome wildcard is development-only; replace it with the published extension origin in production.
CORS_ALLOWED_ORIGINS=http://localhost:4173,null,chrome-extension://*
PUBLIC_WEB_URL=http://localhost:4173

# Optional until a Clerk session-token audience is configured.
CLERK_AUDIENCE=

# Neon pooled connection string for the development branch.
DATABASE_URL=postgresql://replace_me

# Private Cloudflare R2 bucket for encrypted scene packages and capture thumbnails.
# Never expose these credentials to clients.
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=web-to-figma-dev
R2_ENDPOINT=https://replace_me.r2.cloudflarestorage.com
R2_REGION=auto

# Device connection and API-token lifetime defaults.
DEVICE_CONNECTION_TTL_SECONDS=600
DEVICE_POLL_INTERVAL_SECONDS=5
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Conversion queue limits.
CONVERSION_JOB_TTL_SECONDS=1800
MAX_SCENE_PACKAGE_BYTES=26214400
MAX_ACTIVE_CONVERSION_JOBS=3
MAX_STORED_CAPTURE_JOBS=10
MAX_PREVIEW_IMAGE_BYTES=350000
